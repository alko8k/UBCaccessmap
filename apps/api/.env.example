# Copy this file to apps/api/.env and fill in the values.
# That is the only location the API reads: every entry point runs from
# apps/api, and dotenv resolves .env from the working directory.

NODE_ENV=development
PORT=4000

# Local Postgres from docker-compose.yml at the repository root.
# Replace with your hosted connection string when deploying.
DATABASE_URL=postgresql://ubcaccessmap:ubcaccessmap@localhost:5432/ubcaccessmap

WEB_ORIGIN=http://localhost:5173
API_ORIGIN=http://localhost:4000

# Used to hash sign-in tokens and session cookies. Use a long random value.
SESSION_SECRET=replace-with-a-long-random-string

# Comma separated. These addresses get the moderator role on first sign-in.
ADMIN_EMAILS=you@ubc.ca

# Set to true when serving over HTTPS.
COOKIE_SECURE=false

# Email delivery.
# Leave SMTP_USER and SMTP_PASS unset in development and sign-in links are
# logged to the console instead of being sent. Both are required to start in
# production; the server refuses to boot without them.
#
# For Gmail, SMTP_PASS must be a Google App Password
# (Account > Security > 2-Step Verification > App passwords), not your normal
# account password, and 2-Step Verification must be enabled. Gmail allows
# roughly 500 messages per day.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
SMTP_FROM=UBC Access Map <you@gmail.com>
