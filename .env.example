# Copy to apps/api/.env.example values, or export these before running the API.
NODE_ENV=development
PORT=4000
DATABASE_URL=postgresql://ubcaccessmap:ubcaccessmap@localhost:5432/ubcaccessmap
WEB_ORIGIN=http://localhost:5173
API_ORIGIN=http://localhost:4000
SESSION_SECRET=replace-with-a-long-random-string
ADMIN_EMAILS=you@ubc.ca
COOKIE_SECURE=false

# Email delivery. Leave SMTP_USER/SMTP_PASS unset in development and sign-in
# links are logged to the console instead of sent. They are required to start
# in production.
#
# For Gmail, SMTP_PASS must be a Google App Password (Account > Security >
# 2-Step Verification > App passwords), not your normal account password.
# Gmail allows roughly 500 messages per day.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
SMTP_FROM=UBC Access Map <you@gmail.com>
